<?xml version="1.0" encoding="UTF-8"?>
<r:REQ-IF xmlns:r="http://www.omg.org/spec/ReqIF/20110401/reqif.xsd" xmlns:xhtml="http://www.w3.org/1999/xhtml" xmlns:tool="urn:slate-test">
  <r:THE-HEADER><r:REQ-IF-HEADER IDENTIFIER="header"><r:TITLE>Flight requirements</r:TITLE></r:REQ-IF-HEADER></r:THE-HEADER>
  <r:CORE-CONTENT><r:REQ-IF-CONTENT>
    <r:DATATYPES>
      <r:DATATYPE-DEFINITION-STRING IDENTIFIER="string" MAX-LENGTH="1000" />
      <r:DATATYPE-DEFINITION-XHTML IDENTIFIER="xhtml" />
      <r:DATATYPE-DEFINITION-BOOLEAN IDENTIFIER="boolean" />
      <r:DATATYPE-DEFINITION-INTEGER IDENTIFIER="integer" MIN="0" MAX="100" />
      <r:DATATYPE-DEFINITION-REAL IDENTIFIER="real" MIN="0" MAX="5" ACCURACY="2" />
      <r:DATATYPE-DEFINITION-DATE IDENTIFIER="date" />
      <r:DATATYPE-DEFINITION-ENUMERATION IDENTIFIER="status"><r:SPECIFIED-VALUES><r:ENUM-VALUE IDENTIFIER="draft" LONG-NAME="Draft" /><r:ENUM-VALUE IDENTIFIER="approved" LONG-NAME="Approved" /></r:SPECIFIED-VALUES></r:DATATYPE-DEFINITION-ENUMERATION>
    </r:DATATYPES>
    <r:SPEC-TYPES>
      <r:SPEC-OBJECT-TYPE IDENTIFIER="requirement" LONG-NAME="Requirement"><r:SPEC-ATTRIBUTES>
        <r:ATTRIBUTE-DEFINITION-STRING IDENTIFIER="title" LONG-NAME="Title"><r:TYPE><r:DATATYPE-DEFINITION-STRING-REF>string</r:DATATYPE-DEFINITION-STRING-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-STRING>
        <r:ATTRIBUTE-DEFINITION-XHTML IDENTIFIER="text" LONG-NAME="Text"><r:TYPE><r:DATATYPE-DEFINITION-XHTML-REF>xhtml</r:DATATYPE-DEFINITION-XHTML-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-XHTML>
        <r:ATTRIBUTE-DEFINITION-BOOLEAN IDENTIFIER="verified" LONG-NAME="Verified"><r:TYPE><r:DATATYPE-DEFINITION-BOOLEAN-REF>boolean</r:DATATYPE-DEFINITION-BOOLEAN-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-BOOLEAN>
        <r:ATTRIBUTE-DEFINITION-INTEGER IDENTIFIER="count" LONG-NAME="Count"><r:TYPE><r:DATATYPE-DEFINITION-INTEGER-REF>integer</r:DATATYPE-DEFINITION-INTEGER-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-INTEGER>
        <r:ATTRIBUTE-DEFINITION-REAL IDENTIFIER="delay" LONG-NAME="Delay"><r:TYPE><r:DATATYPE-DEFINITION-REAL-REF>real</r:DATATYPE-DEFINITION-REAL-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-REAL>
        <r:ATTRIBUTE-DEFINITION-DATE IDENTIFIER="date-value" LONG-NAME="Review date"><r:TYPE><r:DATATYPE-DEFINITION-DATE-REF>date</r:DATATYPE-DEFINITION-DATE-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-DATE>
        <r:ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="state" LONG-NAME="Status" MULTI-VALUED="false"><r:TYPE><r:DATATYPE-DEFINITION-ENUMERATION-REF>status</r:DATATYPE-DEFINITION-ENUMERATION-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-ENUMERATION>
        <r:ATTRIBUTE-DEFINITION-ENUMERATION IDENTIFIER="multi" LONG-NAME="Review stages" MULTI-VALUED="true"><r:TYPE><r:DATATYPE-DEFINITION-ENUMERATION-REF>status</r:DATATYPE-DEFINITION-ENUMERATION-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-ENUMERATION>
        <r:ATTRIBUTE-DEFINITION-STRING IDENTIFIER="default" LONG-NAME="Default owner"><r:TYPE><r:DATATYPE-DEFINITION-STRING-REF>string</r:DATATYPE-DEFINITION-STRING-REF></r:TYPE><r:DEFAULT-VALUE><r:ATTRIBUTE-VALUE-STRING THE-VALUE="Team"><r:DEFINITION><r:ATTRIBUTE-DEFINITION-STRING-REF>default</r:ATTRIBUTE-DEFINITION-STRING-REF></r:DEFINITION></r:ATTRIBUTE-VALUE-STRING></r:DEFAULT-VALUE></r:ATTRIBUTE-DEFINITION-STRING>
        <r:ATTRIBUTE-DEFINITION-STRING IDENTIFIER="locked" LONG-NAME="Locked field" IS-EDITABLE="false"><r:TYPE><r:DATATYPE-DEFINITION-STRING-REF>string</r:DATATYPE-DEFINITION-STRING-REF></r:TYPE></r:ATTRIBUTE-DEFINITION-STRING>
      </r:SPEC-ATTRIBUTES></r:SPEC-OBJECT-TYPE>
      <r:SPEC-RELATION-TYPE IDENTIFIER="derives" LONG-NAME="Derives from" />
    </r:SPEC-TYPES>
    <r:SPEC-OBJECTS>
      <r:SPEC-OBJECT IDENTIFIER="REQ-1" LONG-NAME="Position accuracy" LAST-CHANGE="2026-01-01T00:00:00Z"><r:TYPE><r:SPEC-OBJECT-TYPE-REF>requirement</r:SPEC-OBJECT-TYPE-REF></r:TYPE><r:VALUES>
        <r:ATTRIBUTE-VALUE-STRING THE-VALUE='Position &amp; accuracy'><r:DEFINITION><r:ATTRIBUTE-DEFINITION-STRING-REF>title</r:ATTRIBUTE-DEFINITION-STRING-REF></r:DEFINITION></r:ATTRIBUTE-VALUE-STRING>
        <r:ATTRIBUTE-VALUE-XHTML><r:DEFINITION><r:ATTRIBUTE-DEFINITION-XHTML-REF>text</r:ATTRIBUTE-DEFINITION-XHTML-REF></r:DEFINITION><r:THE-VALUE><xhtml:div><xhtml:p>The aircraft shall report <xhtml:strong>position</xhtml:strong> within 1 m.</xhtml:p><xhtml:table><xhtml:tr><xhtml:td>GPS</xhtml:td><xhtml:td>1 m</xhtml:td></xhtml:tr></xhtml:table><xhtml:img src="https://invalid.example/track" onerror="window.reqifExecuted = true" alt="Diagram" /><xhtml:script>window.reqifExecuted = true</xhtml:script></xhtml:div></r:THE-VALUE></r:ATTRIBUTE-VALUE-XHTML>
        <r:ATTRIBUTE-VALUE-BOOLEAN THE-VALUE="false"><r:DEFINITION><r:ATTRIBUTE-DEFINITION-BOOLEAN-REF>verified</r:ATTRIBUTE-DEFINITION-BOOLEAN-REF></r:DEFINITION></r:ATTRIBUTE-VALUE-BOOLEAN>
        <r:ATTRIBUTE-VALUE-INTEGER THE-VALUE="2"><r:DEFINITION><r:ATTRIBUTE-DEFINITION-INTEGER-REF>count</r:ATTRIBUTE-DEFINITION-INTEGER-REF></r:DEFINITION></r:ATTRIBUTE-VALUE-INTEGER>
        <r:ATTRIBUTE-VALUE-REAL THE-VALUE="1.25"><r:DEFINITION><r:ATTRIBUTE-DEFINITION-REAL-REF>delay</r:ATTRIBUTE-DEFINITION-REAL-REF></r:DEFINITION></r:ATTRIBUTE-VALUE-REAL>
        <r:ATTRIBUTE-VALUE-DATE THE-VALUE="2026-01-01T00:00:00Z"><r:DEFINITION><r:ATTRIBUTE-DEFINITION-DATE-REF>date-value</r:ATTRIBUTE-DEFINITION-DATE-REF></r:DEFINITION></r:ATTRIBUTE-VALUE-DATE>
        <r:ATTRIBUTE-VALUE-ENUMERATION><r:DEFINITION><r:ATTRIBUTE-DEFINITION-ENUMERATION-REF>state</r:ATTRIBUTE-DEFINITION-ENUMERATION-REF></r:DEFINITION><r:VALUES><!-- preserve enum metadata --><tool:selection note="keep" /><r:ENUM-VALUE-REF>draft</r:ENUM-VALUE-REF></r:VALUES></r:ATTRIBUTE-VALUE-ENUMERATION>
        <r:ATTRIBUTE-VALUE-ENUMERATION><r:DEFINITION><r:ATTRIBUTE-DEFINITION-ENUMERATION-REF>multi</r:ATTRIBUTE-DEFINITION-ENUMERATION-REF></r:DEFINITION><r:VALUES/></r:ATTRIBUTE-VALUE-ENUMERATION>
      </r:VALUES><!-- retain this exact comment --><tool:metadata tool:flag='unchanged'><![CDATA[opaque <payload> & data]]></tool:metadata></r:SPEC-OBJECT>
      <r:SPEC-OBJECT IDENTIFIER="REQ-2" LONG-NAME="Position display"><r:TYPE><r:SPEC-OBJECT-TYPE-REF>requirement</r:SPEC-OBJECT-TYPE-REF></r:TYPE><r:VALUES/></r:SPEC-OBJECT>
      <r:SPEC-OBJECT IDENTIFIER="REQ-3" LONG-NAME="Unassigned requirement"><r:TYPE><r:SPEC-OBJECT-TYPE-REF>requirement</r:SPEC-OBJECT-TYPE-REF></r:TYPE></r:SPEC-OBJECT>
    </r:SPEC-OBJECTS>
    <r:SPEC-RELATIONS><r:SPEC-RELATION IDENTIFIER="REL-1"><r:TYPE><r:SPEC-RELATION-TYPE-REF>derives</r:SPEC-RELATION-TYPE-REF></r:TYPE><r:SOURCE><r:SPEC-OBJECT-REF>REQ-2</r:SPEC-OBJECT-REF></r:SOURCE><r:TARGET><r:SPEC-OBJECT-REF>REQ-1</r:SPEC-OBJECT-REF></r:TARGET></r:SPEC-RELATION></r:SPEC-RELATIONS>
    <r:SPECIFICATIONS><r:SPECIFICATION IDENTIFIER="spec" LONG-NAME="Flight"><r:CHILDREN><r:SPEC-HIERARCHY IDENTIFIER="h1"><r:OBJECT><r:SPEC-OBJECT-REF>REQ-1</r:SPEC-OBJECT-REF></r:OBJECT><r:CHILDREN><r:SPEC-HIERARCHY IDENTIFIER="h2"><r:OBJECT><r:SPEC-OBJECT-REF>REQ-2</r:SPEC-OBJECT-REF></r:OBJECT></r:SPEC-HIERARCHY></r:CHILDREN></r:SPEC-HIERARCHY></r:CHILDREN></r:SPECIFICATION></r:SPECIFICATIONS>
  </r:REQ-IF-CONTENT></r:CORE-CONTENT>
  <r:TOOL-EXTENSIONS><tool:extension value="keep exactly" /></r:TOOL-EXTENSIONS>
</r:REQ-IF>

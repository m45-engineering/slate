{
  "name": "slate-desktop",
  "version": "0.1.4",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "description": "A quiet place to write. A local Markdown editor for people and their tools.",
  "author": "M45 Engineering",
  "main": "electron/main.cjs",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "node scripts/start.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.cjs",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm test",
    "package": "pnpm icons && pnpm build && electron-builder --publish never",
    "package:mac": "pnpm icons && pnpm build && electron-builder --mac dmg --publish never",
    "package:win": "pnpm icons && pnpm build && electron-builder --win nsis --publish never",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tiptap/extension-code-block": "3.33.1",
    "@tiptap/extension-mathematics": "3.33.1",
    "@tiptap/extension-placeholder": "3.33.1",
    "@tiptap/extension-table": "3.33.1",
    "@tiptap/extension-task-item": "3.33.1",
    "@tiptap/extension-task-list": "3.33.1",
    "@tiptap/markdown": "3.33.1",
    "@tiptap/pm": "3.33.1",
    "@tiptap/react": "3.33.1",
    "@tiptap/starter-kit": "3.33.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "1.9.2",
    "highlight.js": "^11.12.0",
    "katex": "0.18.10",
    "lucide-react": "^1.72.0",
    "mermaid": "12.3.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.21.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "sharp"
    ]
  },
  "build": {
    "appId": "engineering.m45.slate",
    "productName": "Slate",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "LICENSE",
      "NOTICE",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown"
        ],
        "name": "Markdown document",
        "role": "Editor"
      }
    ],
    "mac": {
      "identity": "-",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": "dmg",
      "hardenedRuntime": false,
      "notarize": false
    },
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 M45 Engineering",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "dmg": {
      "title": "Slate",
      "background": "build/dmg-background.png",
      "window": {
        "width": 660,
        "height": 420
      },
      "iconSize": 96,
      "iconTextSize": 14,
      "contents": [
        {
          "x": 170,
          "y": 205,
          "type": "file"
        },
        {
          "x": 490,
          "y": 205,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "productName": "Slate"
}
